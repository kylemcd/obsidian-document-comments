{
	"name": "document-comments",
	"version": "0.1.12",
	"description": "Notion-style margin comments for Obsidian, stored inline in markdown.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "node node_modules/typescript-7/bin/tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"typecheck": "node node_modules/typescript-7/bin/tsc -noEmit -skipLibCheck",
		"format": "oxfmt src test vitest.config.ts",
		"format:check": "oxfmt --check src test vitest.config.ts",
		"lint": "oxlint src test vitest.config.ts && eslint src package.json",
		"lint:fix": "oxlint src test vitest.config.ts --fix && eslint src package.json --fix",
		"test": "vitest run",
		"test:watch": "vitest",
		"check": "npm run format:check && npm run lint && npm run typecheck && npm test"
	},
	"keywords": [
		"obsidian-plugin"
	],
	"author": "Kyle McDonald",
	"license": "MIT",
	"devDependencies": {
		"@codemirror/state": "^6.7.1",
		"@codemirror/view": "^6.43.8",
		"@types/node": "^26.1.2",
		"esbuild": "^0.28.1",
		"eslint": "^10.8.0",
		"eslint-plugin-obsidianmd": "^0.4.1",
		"happy-dom": "^20.11.1",
		"obsidian": "^1.5.7",
		"oxfmt": "^0.62.0",
		"oxlint": "^1.77.0",
		"typescript": "^6.0.3",
		"typescript-7": "npm:typescript@^7.0.2",
		"typescript-eslint": "^8.65.0",
		"vitest": "^4.1.10"
	},
	"dependencies": {
		"better-result": "^2.10.0"
	}
}
